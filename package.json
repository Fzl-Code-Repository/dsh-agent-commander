{
  "name": "dsh-agent-commander",
  "version": "0.3.0",
  "description": "指挥本机智能体（Qoder CN / WorkBuddy）干活的 DSH 插件：派活、看进度、验收一条龙，自带网页控制台。支持无头 CLI 与桌面 GUI 两条通道。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent",
    "orchestration",
    "qoder",
    "workbuddy",
    "codebuddy"
  ],
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fzl-Code-Repository/dsh-agent-commander.git"
  },
  "bugs": {
    "url": "https://github.com/Fzl-Code-Repository/dsh-agent-commander/issues"
  },
  "homepage": "https://github.com/Fzl-Code-Repository/dsh-agent-commander#readme",
  "scripts": {
    "test": "node test/smoke.mjs",
    "test:console": "node test/console.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
